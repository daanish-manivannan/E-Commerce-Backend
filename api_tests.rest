### 1. Variables Definition
# Kong Gateway Host on port 8080
@baseUrl = http://127.0.0.1:8080
@contentType = application/json

# Test user credentials (matches .env)
@apiTestEmail = daanish@test.com
@apiTestPassword = P@ssword


### 2. Register New User (FastAPI Identity Service)
# This will also sync the shadow user inside Django's DB.
# If the user is already registered, this might return a 400.
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
    "email": "{{apiTestEmail}}",
    "password": "{{apiTestPassword}}"
}


### 3. Authenticate & Obtain JWT Token (FastAPI Identity Service via Kong)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
    "email": "{{apiTestEmail}}",
    "password": "{{apiTestPassword}}"
}


### Extract the JWT Token dynamically from the login response (FastAPI uses access_token)
@authToken = {{login.response.body.access_token}}


### 4. Fetch Public Product Catalog
# Unauthenticated route (Allowed directly)
GET {{baseUrl}}/api/products/items/
Content-Type: {{contentType}}


### 5. Create a New Order (Requires Auth Token)
# Protected route (Validated by Kong, user parsed by Django)
# @name createOrder
POST {{baseUrl}}/api/orders/
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
    "items": [
        {"product": 1, "quantity": 1},
        {"product": 5, "quantity": 2}
    ]
}


### Extract the generated Order ID dynamically from the response
@orderId = {{createOrder.response.body.id}}


### 6. Generate Stripe Checkout Session Link (Requires Auth Token)
# Legacy path from the API Spec (/orders/{{orderId}}/create-checkout-session/)
POST {{baseUrl}}/orders/{{orderId}}/create-checkout-session/
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{}